# A personal access token, so the CLI can create and migrate the project
# without an interactive browser login. Create one at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Supabase project keys. scripts/setup-supabase.sh writes these for you after
# creating the project; you only need to fill them in by hand if you made the
# project in the dashboard instead. Copy them from Project Settings, API. Without them the app runs on local state exactly
# as it does today, so the demo never breaks for want of a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses every row level security policy. Server only, never prefixed with
# NEXT_PUBLIC, and never committed. Used by the Stripe webhook, which has no
# signed in person to act as.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Test keys until there is a real association taking real money; going
# live is these three values plus Stripe activation, no code change.
#
# The webhook endpoint MUST be registered as a Connect endpoint ("listen on
# connected accounts") subscribing to payment_intent.* and setup_intent.* — a
# plain platform endpoint silently hears nothing about direct charges. Local dev:
#   stripe listen --forward-connect-to localhost:3000/api/stripe/webhook
# and paste the printed whsec_ value here.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# The platform's own subscription webhook (how associations pay us), a second,
# plain endpoint on the platform account listening to customer.subscription.*
# and invoice.*. Different secret because it is a different endpoint.
STRIPE_BILLING_WEBHOOK_SECRET=

# Shared with Vercel's cron scheduler. Anything long and random. Guards
# /api/billing/sweep and /api/autopay/run, which move money and send email.
CRON_SECRET=

# Hosts a continuation of a cron run may call, comma separated. Vercel's own
# hostnames are allowed without this; a deployment that is not on Vercel (the
# Azure Container App, when it comes) names itself here, or the run stops at
# the time limit and waits for tomorrow's schedule.
CRON_ALLOWED_HOSTS=

# Email. Resend's free tier is 3,000 a month on one verified domain, which is
# enough to build against. https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain verified with Resend. Without it, sending
# falls back to Resend's shared tester, which only delivers to your own inbox.
EMAIL_FROM="Your Association <dues@yourdomain.com>"
# Signs unsubscribe links so they work without a login and cannot be forged.
# Any long random string. Changing it invalidates links already in inboxes.
EMAIL_TOKEN_SECRET=

# Enables the test data tools at /dev/reset, which delete real rows with none
# of the product's guards. Never set this in production.
ALLOW_TEST_RESET=false
# The second lock on those tools: the reference of the Supabase project they
# may wipe (the subdomain of NEXT_PUBLIC_SUPABASE_URL). Set it only for a
# staging project. Left empty, the tools refuse.
TEST_RESET_PROJECT_REF=
