{
  "name": "your-hoasis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/timed-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents:verify": "node scripts/verify-agent-docs.mjs",
    "flags:verify": "node scripts/verify-module-flags.mjs",
    "api:generate": "node scripts/generate-api-reference.mjs",
    "api:verify": "node scripts/generate-api-reference.mjs --check",
    "analyze": "next experimental-analyze --output",
    "knip": "knip",
    "duplicate:check": "jscpd src tests --config .jscpd.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && tsc --noEmit && pnpm agents:verify && pnpm flags:verify && pnpm api:verify && pnpm knip && pnpm duplicate:check && vitest run && pnpm build",
    "db:link": "supabase link --project-ref",
    "db:push": "supabase db push",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "email:setup": "node scripts/setup-resend.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "db:verify": "node scripts/verify-all.mjs",
    "db:verify:staging": "ENV_FILE=../.env.staging node scripts/verify-all.mjs",
    "staging:setup": "node scripts/setup-staging.mjs",
    "shots": "node scripts/product-shots.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:playground": "node scripts/seed-playground.mjs",
    "db:export": "node scripts/export-association.mjs",
    "stripe:setup": "node scripts/setup-stripe.mjs && node scripts/setup-stripe-portal.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@microsoft/opentelemetry": "^1.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "jsdom": "^30.0.1",
    "knip": "^6.41.0",
    "prettier": "^3.9.9",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
