# Everything the Azure deployment needs, in one gitignored file (.env.azure).
# scripts/azure/secrets.sh puts the secret lines into Key Vault;
# scripts/azure/provision.sh passes the public lines to the Container App.
# Values marked (same) are the ones already in .env.local.

# ---- public, compiled into the app and set on the Container App
APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=            # hosted project URL for phase 1; the Azure stack's URL after the database moves
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # (same) the JWT secret is reused, so the key does not change
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # (same)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SITE_HOST=               # staging.yourhoasis.com, later yourhoasis.com
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_TEST_LOGINS=             # (same)
EMAIL_FROM=                          # (same)
PLATFORM_OWNER_EMAILS=               # (same)
BUDGET_EMAIL=                        # who gets the spend alerts and the site-down alert
UPTIME_URL=                          # https://www.yourhoasis.com/api/health once the domain is bound; empty before

# ---- secrets, into Key Vault
SUPABASE_SERVICE_ROLE_KEY=           # (same)
STRIPE_SECRET_KEY=                   # (same)
STRIPE_WEBHOOK_SECRET=               # a NEW endpoint per host: pnpm stripe:setup https://<host>
STRIPE_BILLING_WEBHOOK_SECRET=       # same note
CRON_SECRET=                         # (same)
RESEND_API_KEY=                      # (same)
EMAIL_TOKEN_SECRET=                  # (same)

# ---- the database move (scripts/azure/db-migrate.sh)
SUPABASE_JWT_SECRET=                 # Supabase dashboard, Settings, API, JWT secret (or the management API, see the plan)
SUPABASE_DB_PASSWORD=                # (same)
SUPABASE_PROJECT_REF=lhplcojgoysfnltqlgfx
SUPABASE_POOLER_HOST=aws-0-us-west-2.pooler.supabase.com
