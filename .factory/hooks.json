{
  "PreToolUse": [
    {
      "matcher": "Create|Edit|ApplyPatch|Execute",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$FACTORY_PROJECT_DIR\"/.factory/hooks/guard.mjs",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Create|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$FACTORY_PROJECT_DIR\"/.factory/hooks/lint-edited.mjs",
          "timeout": 60
        }
      ]
    }
  ]
}
